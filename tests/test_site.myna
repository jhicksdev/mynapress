@target(py)
<tempfile, shutil, re
<pathlib:{Path}

@repo_root()->Path {
  ^ Path(__file__).resolve().parent.parent
}

@build_fixture(name:s, out:Path, drafts:b=F)->BuildResult {
  config = load_config(@str(repo_root() / "fixtures" / name / "site.toml"))
  config.output_dir = @str(out)
  ^ build_site(config, drafts)
}

@normalize_output(text:s)->s {
  normalized = text.replace("\r\n", "\n")
  normalized = re.sub(_"<lastBuildDate>.*?</lastBuildDate>", "<lastBuildDate></lastBuildDate>", normalized)
  ^ normalized
}

@test_fixture_build_semantics {
  out = Path(tempfile.mkdtemp())
  !{
    result = build_fixture("site", out, F)
    !? result.pages == 5, "page count"
    !? result.posts == 3, "post count"
    !? result.tags == 3, "tag count"
    !? (out / "index.html").exists(), "homepage"
    !? (out / "assets" / "style.css").exists(), "static asset preserved under assets/"
    !? !(out / "draft-post" / "index.html").exists(), "draft excluded"
    !? (out / "tags" / "myna" / "index.html").exists(), "tag page"
    !? (out / "page" / "2" / "index.html").exists(), "pagination page"
    !? (out / "rss.xml").exists() && (out / "sitemap.xml").exists() && (out / "robots.txt").exists(), "generated XML files"
    index = (out / "index.html").read_text(encoding="utf-8")
    !? index.find("Second Post") < index.find("Hello MynaPress"), "posts newest-first"
    rss = (out / "rss.xml").read_text(encoding="utf-8")
    !? "https://example.test/hello-mynapress/" <- rss, "absolute feed URL"
    sitemap = (out / "sitemap.xml").read_text(encoding="utf-8")
    !? "https://example.test/tags/myna/" <- sitemap, "tag URL in sitemap"
  } !: {
    shutil.rmtree(out, ignore_errors=T)
  }
}

@test_blog_pagination_and_drafts {
  out = Path(tempfile.mkdtemp())
  !{
    result = build_fixture("blog", out, F)
    !? result.posts == 3, "draft excluded from count"
    !? !(out / "draft" / "index.html").exists(), "draft page absent"
    p2 = (out / "page" / "2" / "index.html").read_text(encoding="utf-8")
    !? "Beta" <- p2, "page 2 has beta"
    p3 = (out / "page" / "3" / "index.html").read_text(encoding="utf-8")
    !? "Gamma" <- p3, "page 3 has gamma"
    !? 'href="/page/3/"' <- p2, "next link"
    !? 'href="/"' <- p2, "newer link"
    !? !("Alpha" <- p2), "page 2 does not repeat alpha"
  } !: {
    shutil.rmtree(out, ignore_errors=T)
  }
  out2 = Path(tempfile.mkdtemp())
  !{
    result = build_fixture("blog", out2, T)
    !? result.posts == 4, "drafts included with flag"
    draft = (out2 / "draft" / "index.html").read_text(encoding="utf-8")
    !? "Draft" <- draft, "draft page rendered"
  } !: {
    shutil.rmtree(out2, ignore_errors=T)
  }
}

@test_expected_output_matches {
  out = Path(tempfile.mkdtemp())
  !{
    build_fixture("blog", out, F)
    expected = repo_root() / "fixtures" / "blog" / "expected"
    checks = [
      "index.html",
      "page/2/index.html",
      "alpha/index.html",
      "tags/myna/index.html",
      "rss.xml",
      "sitemap.xml"
    ]
    % rel <- checks {
      actual_path = out / rel
      !? actual_path.exists(), `missing generated file: {rel}`
      expected_path = expected / rel
      !? expected_path.exists(), `missing expected file: {rel}`
      actual = normalize_output(actual_path.read_text(encoding="utf-8"))
      wanted = normalize_output(expected_path.read_text(encoding="utf-8"))
      !? actual == wanted, `output differs for {rel}`
    }
  } !: {
    shutil.rmtree(out, ignore_errors=T)
  }
}

@test_url_and_tag_collisions {
  a = Page(title="A", slug="same", url="/same/", source="a.md")
  b = Page(title="B", slug="same", url="/same/", source="b.md")
  !{
    validate_urls([a, b])
    !? F, "duplicate URLs should fail"
  } !! :ValueError {
    _
  }
  post1 = Page(title="One", date="2026-01-01", slug="one", tags=["C++"], url="/one/", type="post")
  post2 = Page(title="Two", date="2026-01-02", slug="two", tags=["C--"], url="/two/", type="post")
  !{
    tag_infos([post1, post2])
    !? F, "tag slug collision should fail"
  } !! :ValueError {
    _
  }
}

@test_base_path_build {
  root = Path(tempfile.mkdtemp())
  !{
    site = root / "site"
    (site / "content").mkdir(parents=True)
    (site / "templates").mkdir()
    (site / "site.toml").write_text('title = "Subpath Site"\nbase_url = "https://example.test/docs"\nbase_path = "/docs/"\n', encoding="utf-8")
    (site / "content" / "index.md").write_text("---\ntitle: Home\n---\n\n[Guide](/guide/) [Ext](https://example.com/) ![Logo](/logo.png)\n", encoding="utf-8")
    (site / "templates" / "base.html").write_text('<!doctype html><link rel="stylesheet" href="{{ \'/assets/style.css\' | url }}"><main>{% block content %}{% endblock %}</main>', encoding="utf-8")
    (site / "templates" / "page.html").write_text('{% extends "base.html" %}{% block content %}{{ content | safe }}<a href="{{ \'/about/\' | url }}">About</a>{% endblock %}', encoding="utf-8")
    config = load_config(@str(site / "site.toml"))
    !? config.base_path == "/docs", "base_path normalized"
    config.output_dir = @str(root / "out")
    build_site(config)
    html = (root / "out" / "index.html").read_text(encoding="utf-8")
    !? 'href="/docs/assets/style.css"' <- html, "template asset prefixed"
    !? '<a href="/docs/guide/">Guide</a>' <- html, "content link prefixed"
    !? '<img src="/docs/logo.png" alt="Logo">' <- html, "content image prefixed"
    !? 'href="/docs/about/"' <- html, "template page link prefixed"
    !? 'href="https://example.com/"' <- html, "absolute link untouched"
    sitemap = (root / "out" / "sitemap.xml").read_text(encoding="utf-8")
    !? "https://example.test/docs/" <- sitemap, "absolute sitemap URL uses base_url"
  } !: {
    shutil.rmtree(root, ignore_errors=T)
  }
}

@make_minimal_site(root:Path)->SiteConfig {
  site = root / "site"
  (site / "content").mkdir(parents=True)
  (site / "templates").mkdir()
  (site / "site.toml").write_text('title = "Minimal Site"\n', encoding="utf-8")
  (site / "content" / "index.md").write_text("---\ntitle: Home\n---\n\nOld home.\n", encoding="utf-8")
  (site / "templates" / "page.html").write_text("{% extends \"base.html\" %}{% block content %}<h1>{{ page.title }}</h1>{{ content | safe }}{% endblock %}", encoding="utf-8")
  (site / "templates" / "base.html").write_text("<main>{% block content %}{% endblock %}</main>", encoding="utf-8")
  ^ load_config(@str(site / "site.toml"))
}

@test_output_path_safety {
  root = Path(tempfile.mkdtemp())
  !{
    config = make_minimal_site(root)
    site = Path(config.root)
    content_index = site / "content" / "index.md"

    config.output_dir = @str(site)
    !{
      build_site(config)
      !? F, "site root output must be refused"
    } !! :ValueError {
      _
    }
    !? content_index.exists(), "site root preserved"

    config.output_dir = @str(site / "content" / "build")
    !{
      build_site(config)
      !? F, "output inside content must be refused"
    } !! :ValueError {
      _
    }
    !? content_index.exists(), "content preserved"

    unmarked = root / "unmarked"
    unmarked.mkdir()
    (unmarked / "keep.txt").write_text("keep\n", encoding="utf-8")
    config.output_dir = @str(unmarked)
    !{
      build_site(config)
      !? F, "unmarked output must be refused"
    } !! :ValueError {
      _
    }
    !? (unmarked / "keep.txt").exists(), "unmarked directory preserved"

    empty = root / "empty-out"
    empty.mkdir()
    config.output_dir = @str(empty)
    build_site(config)
    !? (empty / "index.html").exists(), "empty output initialized"
    !? (empty / output_marker()).exists(), "empty output marked after build"
  } !: {
    shutil.rmtree(root, ignore_errors=T)
  }
}

@test_failed_build_preserves_output {
  root = Path(tempfile.mkdtemp())
  !{
    config = make_minimal_site(root)
    out = root / "out"
    config.output_dir = @str(out)
    build_site(config)
    before = (out / "index.html").read_text(encoding="utf-8")
    !? (out / output_marker()).exists(), "output is marked"

    (Path(config.root) / "content" / "broken.md").write_text("---\ntitle: Broken\ndate: someday\n---\n\nBroken.\n", encoding="utf-8")
    !{
      build_site(config)
      !? F, "invalid content must fail"
    } !! :ValueError {
      _
    }
    after = (out / "index.html").read_text(encoding="utf-8")
    !? before == after, "previous output preserved after failed build"
    !? (out / output_marker()).exists(), "marker preserved"
    !? #@list(root.glob(".mynapress-build-*")) == 0, "failed build leaves no staging directory"
    !? #@list(root.glob(".mynapress-backup-*")) == 0, "successful swap leaves no backup directory"
  } !: {
    shutil.rmtree(root, ignore_errors=T)
  }
}

@test_config_validation {
  root = Path(tempfile.mkdtemp())
  !{
    bad = root / "bad.toml"
    bad.write_text("title = \"X\"\nnope = 1\n", encoding="utf-8")
    !{
      load_config(@str(bad))
      !? F, "unknown key should fail"
    } !! :ValueError {
      _
    }
    bad.write_text("description = \"X\"\n", encoding="utf-8")
    !{
      load_config(@str(bad))
      !? F, "missing title should fail"
    } !! :ValueError {
      _
    }
    bad.write_text("title = \"X\"\npaginate = \"two\"\n", encoding="utf-8")
    !{
      load_config(@str(bad))
      !? F, "wrong paginate type should fail"
    } !! :ValueError {
      _
    }
    bad.write_text("title = \"X\"\npaginate = true\n", encoding="utf-8")
    !{
      load_config(@str(bad))
      !? F, "boolean paginate should fail"
    } !! :ValueError {
      _
    }
    bad.write_text("title = \"X\"\nbase_url = \"example.com\"\n", encoding="utf-8")
    !{
      load_config(@str(bad))
      !? F, "bad base_url should fail"
    } !! :ValueError {
      _
    }
    bad.write_text("title = \"X\"\nbase_path = \"docs\"\n", encoding="utf-8")
    !{
      load_config(@str(bad))
      !? F, "base_path without slash should fail"
    } !! :ValueError {
      _
    }
    bad.write_text("title = \"X\"\nbase_path = \"/docs?x=1\"\n", encoding="utf-8")
    !{
      load_config(@str(bad))
      !? F, "base_path with query should fail"
    } !! :ValueError {
      _
    }
    bad.write_text("title = \"X\"\nbase_path = \"/docs/\"\n", encoding="utf-8")
    !? load_config(@str(bad)).base_path == "/docs", "base_path trailing slash normalized"
    bad.write_text("title = \"X\"\nbase_path = \"/\"\n", encoding="utf-8")
    !? load_config(@str(bad)).base_path == "", "root base_path normalized to empty"
    missing = root / "missing.toml"
    !? load_config(@str(missing)).title == "MynaPress", "missing default config uses defaults"
    !{
      load_config(@str(missing), T)
      !? F, "explicit missing config should fail"
    } !! :ValueError {
      _
    }
  } !: {
    shutil.rmtree(root, ignore_errors=T)
  }
}
