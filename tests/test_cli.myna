@target(py)
<tempfile, shutil
<pathlib:{Path}
<datetime:{date}

@test_new_clean_and_unknown_command {
  root = Path(tempfile.mkdtemp())
  !{
    config = root / "site.toml"
    config.write_text("title = \"CLI Test\"\n", encoding="utf-8")
    code = run_cli(["new", "Hello World!", "--config", @str(config)])
    !? code == 0, "new exit code"
    day = date.today().isoformat()
    expected = root / "content" / `{day}-hello-world.md`
    !? expected.exists(), "new filename is date-based"
    text = expected.read_text(encoding="utf-8")
    !? 'title: "Hello World!"' <- text, "new front matter title"
    !? `date: {day}` <- text, "new front matter date"

    out = root / "build"
    out.mkdir(parents=True, exist_ok=True)
    (out / "index.html").write_text("x", encoding="utf-8")
    cache = root / ".mynapress-cache.json"
    cache.write_text("{}", encoding="utf-8")
    code = run_cli(["clean", "--config", @str(config)])
    !? code == 0, "clean exit code"
    !? !out.exists(), "clean removes output"
    !? !cache.exists(), "clean removes cache"

    !? run_cli(["unknown"]) == 2, "unknown command exits 2"
    !? run_cli([]) == 0, "no arguments prints usage"
  } !: {
    shutil.rmtree(root, ignore_errors=T)
  }
}
