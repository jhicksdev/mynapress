@target(py)
<tomllib
<pathlib:{Path}

$$SiteConfig(
  title:s="MynaPress",
  description:s="",
  base_url:s="",
  base_path:s="",
  author:s="",
  language:s="en",
  paginate:i=10,
  content_dir:s="content",
  output_dir:s="build",
  templates_dir:s="templates",
  static_dir:s="assets",
  root:s="."
)

@config_error(path:s, message:s) {
  !^ ValueError(`{path}: {message}`)
}

@require_str(raw:{s:A}, key:s, default:s, path:s)->s {
  ? !(key <- raw) {
    ^ default
  }
  value = raw[key]
  ? !(value :? s) {
    config_error(path, `config key '{key}' must be a string`)
  }
  ? value.strip() == "" && key != "description" && key != "author" && key != "base_url" && key != "base_path" {
    config_error(path, `config key '{key}' must not be empty`)
  }
  ^ value.strip()
}

@require_int(raw:{s:A}, key:s, default:i, path:s)->i {
  ? !(key <- raw) {
    ^ default
  }
  value = raw[key]
  ? value :? b {
    config_error(path, `config key '{key}' must be an integer, not a boolean`)
  }
  ? !(value :? i) {
    config_error(path, `config key '{key}' must be an integer`)
  }
  ? value < 0 {
    config_error(path, `config key '{key}' must be zero or greater`)
  }
  ^ value
}

@load_config(path_value:s="site.toml", required:b=F)->SiteConfig {
  path = Path(path_value)
  ? !path.exists() {
    ? required {
      !^ ValueError(`config file not found: {path_value}`)
    }
    ^ SiteConfig(root=".")
  }
  !{
    text = path.read_text(encoding="utf-8")
  } !! e:OSError {
    !^ ValueError(`could not read config '{path}': {e}`)
  }
  !{
    raw = tomllib.loads(text)
  } !! e:tomllib.TOMLDecodeError {
    !^ ValueError(`{path}: invalid TOML: {e}`)
  }
  allowed = {"title", "description", "base_url", "base_path", "author", "language", "paginate", "content_dir", "output_dir", "templates_dir", "static_dir"}
  unknown = [k | k <- raw.keys() ? k !<- allowed]
  ? #unknown > 0 {
    !^ ValueError(`{path}: unknown config key(s): {@str(", ".join(unknown))}`)
  }
  title = require_str(raw, "title", "MynaPress", path)
  ? !("title" <- raw) {
    !^ ValueError(`{path}: missing required config key 'title'`)
  }
  base_url = require_str(raw, "base_url", "", path).rstrip("/")
  ? base_url != "" && !(base_url.startswith("http://") || base_url.startswith("https://")) {
    !^ ValueError(`{path}: base_url must start with http:// or https://`)
  }
  base_path = require_str(raw, "base_path", "", path)
  ? base_path != "" {
    ? !base_path.startswith("/") || base_path.startswith("//") {
      !^ ValueError(`{path}: base_path must start with a single '/'`)
    }
    ? "?" <- base_path || "#" <- base_path || " " <- base_path || "\\" <- base_path || "//" <- base_path {
      !^ ValueError(`{path}: base_path must be a plain URL path prefix`)
    }
    base_path = base_path.rstrip("/")
    ? base_path == "/" {
      base_path = ""
    }
  }
  paginate = require_int(raw, "paginate", 10, path)
  root = @str(path.resolve().parent)
  _ = raw
  ^ SiteConfig(
    title=title,
    description=require_str(raw, "description", "", path),
    base_url=base_url,
    base_path=base_path,
    author=require_str(raw, "author", "", path),
    language=require_str(raw, "language", "en", path),
    paginate=paginate,
    content_dir=require_str(raw, "content_dir", "content", path),
    output_dir=require_str(raw, "output_dir", "build", path),
    templates_dir=require_str(raw, "templates_dir", "templates", path),
    static_dir=require_str(raw, "static_dir", "assets", path),
    root=root
  )
}

@site_path(config:SiteConfig, relative:s)->Path {
  p = Path(relative)
  ? p.is_absolute() {
    ^ p
  }
  ^ Path(config.root) / p
}

@output_marker()->s {
  ^ ".mynapress-output"
}

@path_within(path:Path, parent:Path)->b {
  !{
    path.resolve().relative_to(parent.resolve())
    ^ T
  } !! :ValueError {
    ^ F
  }
}

@assert_safe_output(config:SiteConfig, out_dir:Path, require_inside_root:b=F) {
  root = Path(config.root).resolve()
  out = out_dir.resolve()
  ? path_within(root, out) {
    !^ ValueError(`refusing to use '{out_dir}' as the output directory: it is the site root or contains it`)
  }
  sources = [
    site_path(config, config.content_dir),
    site_path(config, config.templates_dir),
    site_path(config, config.static_dir)
  ]
  % source <- sources {
    src = source.resolve()
    ? path_within(out, src) || path_within(src, out) {
      !^ ValueError(`refusing to use '{out_dir}' as the output directory: it overlaps '{source}'`)
    }
  }
  ? require_inside_root && !path_within(out, root) {
    !^ ValueError(`refusing to clean '{out_dir}': the output directory is outside the site root`)
  }
}

@assert_output_target(out_dir:Path, action:s="replace", require_marker:b=F) {
  ? out_dir.is_symlink() {
    !^ ValueError(`refusing to {action} '{out_dir}': it is a symbolic link`)
  }
  ? !out_dir.exists() {
    ^ 0
  }
  ? !out_dir.is_dir() {
    !^ ValueError(`refusing to {action} '{out_dir}': it is not a directory`)
  }
  entries = @list(out_dir.iterdir())
  ? (require_marker || #entries > 0) && !(out_dir / output_marker()).exists() {
    !^ ValueError(`refusing to {action} '{out_dir}': it is not a MynaPress output directory (missing {output_marker()})`)
  }
  ^ 0
}
